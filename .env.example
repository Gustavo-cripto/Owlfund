# Supabase: obrigatório para login (email/senha e Google). Criar projeto em https://supabase.com.
# No dashboard: Settings → API → copiar "Project URL" e "anon public" (não uses o nome da variável como valor).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Blockfrost: necessário para mostrar saldo de endereços Cardano adicionados manualmente.
# Obter em https://blockfrost.io (criar projeto mainnet).
BLOCKFROST_PROJECT_ID=
# DeFi Cardano: valorizado on-chain via Blockfrost (mesma BLOCKFROST_PROJECT_ID
# acima). Não precisa de chave extra — Minswap V1 é avaliado pelas reservas do
# pool; outras DEXes são detetadas e verificadas uma a uma com posição real.

# DeFi: pelo menos um necessário para mostrar posições DeFi (Uniswap, Aave, etc.) no card Ethereum.
# Moralis (gratuito): https://admin.moralis.io/register → criar projeto → copiar API Key.
MORALIS_API_KEY=
# DeFi Solana (Meteora DLMM): usa apenas SHYFT_API_KEY.
# Obter em https://shyft.to/get-api-key
SHYFT_API_KEY=
# RPC Solana (opcional): Helius, QuickNode, etc.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Ordinals/Inscrições Bitcoin: https://developer.unisat.io (plano gratuito).
# Sem esta chave, o card Bitcoin mostra 0 NFTs.
UNISAT_API_KEY=

# WalletConnect: necessário para o botão "WalletConnect (QR)" na página de Carteiras.
# Regista o projeto grátis em https://cloud.walletconnect.com → criar projeto → copiar Project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cron Job (snapshots automáticos diários): qualquer string aleatória segura.
# Adiciona também nas Environment Variables da Vercel (Settings → Environment Variables).
# Exemplo de geração: openssl rand -hex 32
CRON_SECRET=

# Supabase Service Role Key: necessário para o cron guardar snapshots de todos os utilizadores.
# Obtém em: Supabase Dashboard → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=
