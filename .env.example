# Supabase: obrigatório para login (email/senha e Google). Criar projeto em https://supabase.com.
# No dashboard: Settings → API → copiar "Project URL" e "anon public" (não uses o nome da variável como valor).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Blockfrost: necessário para mostrar saldo de endereços Cardano adicionados manualmente.
# Obter em https://blockfrost.io (criar projeto mainnet).
BLOCKFROST_PROJECT_ID=
# DeFi Cardano: valorizado on-chain via Blockfrost (mesma BLOCKFROST_PROJECT_ID
# acima). Não precisa de chave extra — Minswap V1 é avaliado pelas reservas do
# pool; outras DEXes são detetadas e verificadas uma a uma com posição real.

# DeFi: pelo menos um necessário para mostrar posições DeFi (Uniswap, Aave, etc.) no card Ethereum.
# Moralis (gratuito): https://admin.moralis.io/register → criar projeto → copiar API Key.
# Alchemy — fornecedor PRINCIPAL de dados EVM (saldos de tokens com preços, NFTs,
# transferências das baleias). Gratuito: https://dashboard.alchemy.com → Create app → API key.
ALCHEMY_API_KEY=
MORALIS_API_KEY=
# DeFi Solana (Meteora DLMM): usa apenas SHYFT_API_KEY.
# Obter em https://shyft.to/get-api-key
SHYFT_API_KEY=
# RPC Solana (opcional): Helius, QuickNode, etc.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Ordinals/Inscrições Bitcoin: https://developer.unisat.io (plano gratuito).
# Sem esta chave, o card Bitcoin mostra 0 NFTs.
UNISAT_API_KEY=

# WalletConnect: necessário para o botão "WalletConnect (QR)" na página de Carteiras.
# Regista o projeto grátis em https://cloud.walletconnect.com → criar projeto → copiar Project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cron Job (snapshots automáticos diários): qualquer string aleatória segura.
# Adiciona também nas Environment Variables da Vercel (Settings → Environment Variables).
# Exemplo de geração: openssl rand -hex 32
CRON_SECRET=

# Supabase Service Role Key: necessário para o cron guardar snapshots de todos os utilizadores.
# Obtém em: Supabase Dashboard → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe: OBRIGATÓRIO para os planos pagos (Pro/Premium) ──────────────────
# Chaves em https://dashboard.stripe.com/apikeys (usar chaves LIVE em produção).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook: Dashboard → Developers → Webhooks → endpoint /api/webhooks → "Signing secret".
STRIPE_WEBHOOK_SECRET=
# Price IDs (Dashboard → Products). Pro e Premium, mensal e anual.
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID_ANNUAL=
# Espelhos públicos usados no cliente (mesmos IDs Premium acima).
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=
# Preços de FUNDADOR (testers do beta): Pro 9,99 €/mês, Premium 19 €/mês + anuais.
# O checkout aplica-os automaticamente a quem está na tabela `founders`.
STRIPE_FOUNDER_PRO_PRICE_ID=
STRIPE_FOUNDER_PRO_PRICE_ID_ANNUAL=
STRIPE_FOUNDER_PREMIUM_PRICE_ID=
STRIPE_FOUNDER_PREMIUM_PRICE_ID_ANNUAL=
# Interruptor do lançamento: enquanto não for "true", /pricing convida ao beta e
# o checkout devolve 403 (pagamentos congelados). Ver docs/lancamento-runbook.md.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── IA: OBRIGATÓRIO para chat, briefing e análise de notícias ───────────────
# Groq (gratuito, recomendado): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=            # opcional, ex: llama-3.3-70b-versatile
# Alternativas opcionais ao Groq (auto-seleção: Ollama > Groq > xAI > OpenAI):
# OPENAI_API_KEY=
# OPENAI_MODEL=
# XAI_API_KEY=
# XAI_BASE_URL=
# XAI_MODEL=
# OLLAMA_BASE_URL=       # requer host remoto em produção (127.0.0.1 não serve na Vercel)
# OLLAMA_MODEL=
# CHAT_PROVIDER=         # força um provider específico (openai|groq|xai|ollama)

# ── Email: briefing diário por email (planos Pro/Premium) ───────────────────
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Assina o URL de cancelamento dos emails do produto (List-Unsubscribe,
# /api/email/unsubscribe?u=…&t=…). Opcional: sem ele usa-se o CRON_SECRET.
# Mudar o valor invalida os links dos emails já enviados. Ex.: openssl rand -hex 32
# EMAIL_UNSUBSCRIBE_SECRET=

# ── Mercado tradicional (ações, índices, ouro): OBRIGATÓRIO para a aba Tradicional ──
# Twelve Data (gratuito): https://twelvedata.com/apikey
TWELVEDATA_API_KEY=

# ── EVM / Solana (opcionais, melhoram cobertura on-chain) ───────────────────
# Etherscan (saldos/tokens EVM extra): https://etherscan.io/apis
# Histórico de transações ETH no Smart Money (API V2 — a chave gratuita é OBRIGATÓRIA): https://etherscan.io/apis
ETHERSCAN_API_KEY=
# Helius (RPC/dados Solana): https://dev.helius.xyz
# HELIUS_API_KEY=
# RPC Solana server-side (opcional): Helius, QuickNode, etc.
# SOLANA_RPC_URL=

# ── Site / segurança ────────────────────────────────────────────────────────
# URL público do site (canonical, OG, metadataBase). Ex: https://chainfolioai.com
NEXT_PUBLIC_SITE_URL=
# Hosts permitidos para WalletConnect (CSV). Ex: chainfolioai.com,localhost
# NEXT_PUBLIC_ALLOWED_HOSTS=
# Segredo para a rota /api/setup-db (uso pontual de administração).
# SETUP_DB_SECRET=

# ── Pagamentos em cripto (Helio / MoonPay Commerce) ─────────────────────────
# Liga/desliga a UI e as rotas de pagamento cripto sem novo deploy (true/false).
# Só ligar depois de: correr supabase-crypto-payments.sql + preencher tudo abaixo.
NEXT_PUBLIC_CRYPTO_PAYMENTS_ENABLED=false
# Desconto (%) para quem paga em cripto. Default 15. Alterar aqui é opcional
# (também está no código em src/lib/payments/pricing.ts).
# NEXT_PUBLIC_CRYPTO_DISCOUNT_PCT=15
#
# Credenciais Helio (dashboard: moonpay.hel.io → Settings → API).
HELIO_PUBLIC_KEY=
HELIO_API_KEY=
# Token partilhado do webhook (Helio → Webhooks → criar → copiar shared token).
HELIO_WEBHOOK_TOKEN=
# Pay Link IDs criados no dashboard (um por plano×período, com o preço EURC já
# com desconto e o TEU endereço de recebimento configurado em cada um).
HELIO_PAYLINK_PRO_MONTHLY=
HELIO_PAYLINK_PRO_ANNUAL=
HELIO_PAYLINK_PREMIUM_MONTHLY=
HELIO_PAYLINK_PREMIUM_ANNUAL=

# CoinGecko — chave Demo (gratuita: 30 chamadas/min, 10 000/mês). Sem ela os
# pedidos contam pelo IP partilhado da Vercel e o 429 aparece a espaços.
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# ── Cópias de segurança ──────────────────────────────────────────────────────
# A cópia diária (/api/cron/backup, 02:00 UTC) vai sempre para um balde privado
# DESTE projeto. As duas variáveis abaixo acrescentam destinos que cobrem
# desastres que o balde não cobre. Nenhuma é obrigatória.
#
# Espelho num SEGUNDO projeto Supabase (gratuito serve). Sobrevive a perder
# ESTE projeto. Criar projeto novo → Settings → API → URL e service_role key.
BACKUP_MIRROR_URL=
BACKUP_MIRROR_SERVICE_KEY=
#
# Email com a cópia em anexo. É a ÚNICA via que sobrevive a perder a conta do
# Supabase. Ligado por omissão para o BETA_SIGNUP_TO (ou suporte@).
# BACKUP_EMAIL_TO=suporte@chainfolioai.com
# BACKUP_EMAIL_ENABLED=false

# Ligações de afiliado das carteiras físicas (página Carteiras). Sem elas, as
# ligações vão direitas ao fabricante e o aviso diz "sem comissão".
# NEXT_PUBLIC_AFF_LEDGER_URL=
# NEXT_PUBLIC_AFF_TREZOR_URL=

# ── Administração e alertas ──────────────────────────────────────────────────
# Nenhuma destas faz o site cair se faltar — mas cada uma desliga uma função em
# silêncio. Num projeto Vercel novo (recuperação de desastre) ou para um
# colaborador, é aqui que se vê o que ficou apagado.
#
# Emails (CSV) com acesso a /admin/* e às rotas de administração (founder,
# grant-tester). Sem isto: /admin dá "sem acesso" a toda a gente.
ADMIN_EMAILS=
# Token das rotas /api/v1/admin/stats e das cópias de segurança (fail-closed).
# Sem isto: estatísticas de admin e verificação das cópias respondem 401/503.
# Gerar: openssl rand -hex 32
ADMIN_STATS_TOKEN=
# Chave que cifra as chaves de API das corretoras guardadas no servidor (cofre).
# Sem isto: "saldo atualizado com a app fechada" e o cron cex-refresh ficam
# desligados (skipped) e as 13 corretoras só funcionam com a app aberta.
# Gerar: openssl rand -base64 32. NUNCA trocar depois de haver chaves guardadas.
CEX_KEYS_SECRET=
# Segredo entre o middleware e /api/track (contador de visitas humanas/robôs).
# Sem isto: o admin/stats deixa de contar visitas.
TRACK_SECRET=
# Bot do Telegram para os alertas de admin (cron falhado, cópia de segurança,
# testers a expirar, inscrições no beta). Sem isto: TODOS os alertas são no-op.
# Token: @BotFather. chat_id: o teu chat/grupo (ex.: via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Segredo do pseudónimo HMAC das carteiras na API/MCP (wallet_xxxx). Sem isto
# usa a SUPABASE_SERVICE_ROLE_KEY; mudar troca os pseudónimos de toda a gente.
# API_PSEUDONYM_SECRET=
# Para onde vão as notificações internas de inscrição no beta e a cópia por
# email. Sem isto: suporte@chainfolioai.com.
# BETA_SIGNUP_TO=suporte@chainfolioai.com
# Fim do beta (ISO). A partir daqui a página /beta e a API recusam novos
# testers e o cron deixa de mandar ofertas. Vazio = sempre aberto. Fonte única
# em src/lib/plans.ts; é NEXT_PUBLIC_, por isso mudar exige novo deploy.
# NEXT_PUBLIC_BETA_CUTOFF=2027-01-15T23:59:59Z
# Google One Tap na página de login (Client ID OAuth do Google Cloud).
# Sem isto: não aparece o One Tap; o botão "Entrar com Google" continua a
# funcionar pelo Supabase.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# "1" mostra o botão "Entrar com Apple" (exige o provider Apple no Supabase).
# NEXT_PUBLIC_AUTH_APPLE=
# Fornecedor de pagamentos em cripto (hoje só "helio"). Sem isto: as rotas de
# pagamento cripto respondem "não configurado" mesmo com o interruptor ligado.
# CRYPTO_PROVIDER=helio
