# Blockfrost: necessário para mostrar saldo de endereços Cardano adicionados manualmente.
# Obter em https://blockfrost.io (criar projeto mainnet).
BLOCKFROST_PROJECT_ID=

# DeFi: pelo menos um necessário para mostrar posições DeFi (Uniswap, Aave, etc.) no card Ethereum.
# Moralis (gratuito): https://admin.moralis.io/register → criar projeto → copiar API Key.
MORALIS_API_KEY=
# DeFi Solana (Meteora DLMM): usa apenas SHYFT_API_KEY.
# Obter em https://shyft.to/get-api-key
SHYFT_API_KEY=
# RPC Solana (opcional): Helius, QuickNode, etc.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Ordinals/Inscrições Bitcoin: https://developer.unisat.io (plano gratuito).
# Sem esta chave, o card Bitcoin mostra 0 NFTs.
UNISAT_API_KEY=
