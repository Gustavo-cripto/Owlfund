{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/news-briefing",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/crypto-expiry",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/beta-expiry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/whale-alerts",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "15 1 * * *"
    }
  ]
}
