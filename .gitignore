# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capturas originais (por tratar) — nunca publicar
.screenshots-originais/

# Supabase CLI — estado interno/temp (não publicar)
supabase/.temp/
supabase/.branches/

# Capturas originais nunca vao para o repositorio (publico): so os .webp
public/screenshots/*.png
public/screenshots/*.jpg
public/screenshots/*.jpeg

# Playwright (e2e): sessao da conta de teste e relatorios nunca entram no repositorio
e2e/.auth/
playwright-report/
test-results/
mobile/.env
